GROQ_API_KEY=gsk-your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5433/supportpilot
POSTGRES_PASSWORD=YOUR_PASSWORD

# Redis
REDIS_URL=redis://localhost:6379

# Email
SENDGRID_API_KEY=your-sendgrid-key-here
FROM_EMAIL=support@supportpilot.demo
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password-here

# App
APP_ENV=development
SECRET_KEY=change-this-in-production
ADMIN_API_KEY=admin-dev-key

# RAG
RAG_CONFIDENCE_THRESHOLD=0.35
RAG_TOP_K=5
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=80

# HuggingFace
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths
KB_INDEX_PATH=data/kb_index
KB_SOURCE_PATH=data/kb_source_docs